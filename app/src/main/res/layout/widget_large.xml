<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/glass_m" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <!-- Sot | Nesër            ↻ 15:41 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_today"
                style="@style/W.Tab"
                android:background="@drawable/tab_on"
                android:textColor="@color/tab_ink"
                android:text="Sot" />

            <TextView
                android:id="@+id/tab_tomorrow"
                style="@style/W.Tab"
                android:layout_marginStart="6dp"
                android:background="@drawable/tab_off"
                android:text="Nesër" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_updated"
                style="@style/W.Updated"
                android:text="↻ 15:41" />
        </LinearLayout>

        <!-- City, condition, temperature, icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_city"
                    style="@style/W.City"
                    android:text="Prishtinë, Kosovë" />

                <TextView
                    android:id="@+id/tv_cond"
                    style="@style/W.Cond"
                    android:text="Mot i vranët · Ndihet si 9°" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_temp"
                style="@style/W.Temp"
                android:text="12" />

            <TextView
                android:id="@+id/tv_unit"
                style="@style/W.Unit"
                android:text="°C" />

            <TextView
                android:id="@+id/tv_icon"
                style="@style/W.Icon"
                android:text="🌧️" />
        </LinearLayout>

        <!-- Advice -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tv_headline"
                style="@style/W.Headline"
                android:text="Pas dy orësh bie shi." />

            <TextView
                android:id="@+id/tv_line2"
                style="@style/W.Line"
                android:text="E thatë deri në orën 17:00. ✅" />

            <TextView
                android:id="@+id/tv_line3"
                style="@style/W.Line"
                android:text="Vishu trashë – pallto dhe shall. 🧥" />
        </LinearLayout>

        <!-- Next hours -->
        <LinearLayout
            android:id="@+id/hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h0_t"
                    style="@style/W"
                    android:textColor="@color/text3"
                    android:textSize="12sp"
                    android:text="16" />

                <TextView
                    android:id="@+id/h0_e"
                    style="@style/W"
                    android:layout_marginTop="4dp"
                    android:shadowRadius="0"
                    android:textSize="18sp"
                    android:text="☁️" />

                <TextView
                    android:id="@+id/h0_v"
                    style="@style/W"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp"
                    android:text="11°" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h1_t"
                    style="@style/W"
                    android:textColor="@color/text3"
                    android:textSize="12sp"
                    android:text="17" />

                <TextView
                    android:id="@+id/h1_e"
                    style="@style/W"
                    android:layout_marginTop="4dp"
                    android:shadowRadius="0"
                    android:textSize="18sp"
                    android:text="🌦️" />

                <TextView
                    android:id="@+id/h1_v"
                    style="@style/W"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp"
                    android:text="10°" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h2_t"
                    style="@style/W"
                    android:textColor="@color/text3"
                    android:textSize="12sp"
                    android:text="18" />

                <TextView
                    android:id="@+id/h2_e"
                    style="@style/W"
                    android:layout_marginTop="4dp"
                    android:shadowRadius="0"
                    android:textSize="18sp"
                    android:text="🌧️" />

                <TextView
                    android:id="@+id/h2_v"
                    style="@style/W"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp"
                    android:text="9°" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h3_t"
                    style="@style/W"
                    android:textColor="@color/text3"
                    android:textSize="12sp"
                    android:text="19" />

                <TextView
                    android:id="@+id/h3_e"
                    style="@style/W"
                    android:layout_marginTop="4dp"
                    android:shadowRadius="0"
                    android:textSize="18sp"
                    android:text="🌧️" />

                <TextView
                    android:id="@+id/h3_v"
                    style="@style/W"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp"
                    android:text="8°" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/h4_t"
                    style="@style/W"
                    android:textColor="@color/text3"
                    android:textSize="12sp"
                    android:text="20" />

                <TextView
                    android:id="@+id/h4_e"
                    style="@style/W"
                    android:layout_marginTop="4dp"
                    android:shadowRadius="0"
                    android:textSize="18sp"
                    android:text="☁️" />

                <TextView
                    android:id="@+id/h4_v"
                    style="@style/W"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp"
                    android:text="8°" />
            </LinearLayout>
        </LinearLayout>

        <!-- City picker -->
        <LinearLayout
            android:id="@+id/btn_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav" />

            <TextView
                android:id="@+id/tv_pick"
                style="@style/W.Link"
                android:text="@string/pick_city" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
