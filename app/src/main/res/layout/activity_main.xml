<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/T.Title"
                    android:text="@string/app_name" />

                <TextView
                    style="@style/T.Sub"
                    android:text="@string/tagline" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_refresh"
                style="@style/T.IconBtn"
                android:contentDescription="@string/refresh"
                android:text="↻" />
        </LinearLayout>

        <!-- Weather (same glass as the widget) -->
        <LinearLayout
            android:id="@+id/card_weather"
            style="@style/Card"
            android:layout_marginTop="16dp"
            android:background="@drawable/glass_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_city"
                        style="@style/T.City" />

                    <TextView
                        android:id="@+id/tv_cond"
                        style="@style/T.Cond" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_temp"
                    style="@style/T.Temp" />

                <TextView
                    android:id="@+id/tv_icon"
                    style="@style/T.Icon" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_headline"
                style="@style/T.Headline" />

            <LinearLayout
                android:id="@+id/list_msgs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_updated"
                style="@style/T.Small"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- Next hours -->
        <LinearLayout
            android:id="@+id/card_hourly"
            style="@style/Card"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/T.Label"
                android:text="@string/next_hours" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- City -->
        <LinearLayout
            android:id="@+id/row_city"
            style="@style/Card"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/T.Label"
                    android:text="@string/city" />

                <TextView
                    android:id="@+id/tv_city_value"
                    style="@style/T.Value" />
            </LinearLayout>

            <TextView
                style="@style/T.Link"
                android:text="@string/change" />
        </LinearLayout>

        <!-- Refresh interval -->
        <LinearLayout
            style="@style/Card"
            android:orientation="vertical">

            <TextView
                style="@style/T.Label"
                android:text="@string/auto_refresh" />

            <TextView
                style="@style/T.Hint"
                android:text="@string/auto_refresh_hint" />

            <GridLayout
                android:id="@+id/grid_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="-4dp"
                android:columnCount="3" />
        </LinearLayout>

        <!-- Glass transparency -->
        <LinearLayout
            style="@style/Card"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/T.Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/transparency" />

                <TextView
                    android:id="@+id/tv_alpha"
                    style="@style/T.Label" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_alpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="90"
                android:progressBackgroundTint="#66FFFFFF"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />
        </LinearLayout>

        <!-- Background work hint -->
        <LinearLayout
            android:id="@+id/card_battery"
            style="@style/Card"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/T.Body"
                android:text="@string/battery_hint" />

            <TextView
                android:id="@+id/btn_battery"
                style="@style/T.Button"
                android:layout_marginTop="12dp"
                android:text="@string/battery_allow" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_add"
            style="@style/T.ButtonPrimary"
            android:text="@string/add_widget" />

        <TextView
            style="@style/T.Footer"
            android:text="@string/attribution" />
    </LinearLayout>
</ScrollView>
