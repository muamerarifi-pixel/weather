<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass: smoky translucent tint, soft top sheen, thin light edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:angle="315"
                android:centerColor="#B3353C46"
                android:endColor="#BF1D222A"
                android:startColor="#C24F5863"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:angle="270"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#24FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
